{
  "type": "object",
  "required": ["summary", "tasks"],
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string", "description": "How the contract was decomposed and why, in a short paragraph." },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "title", "goal", "acceptanceCriteria", "dependsOn", "size"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "Short kebab-case id unique within this plan." },
          "title": { "type": "string" },
          "goal": { "type": "string" },
          "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "size": { "type": "string", "enum": ["s", "m", "l"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
